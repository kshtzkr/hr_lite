<%# locals: month (Date, any day in month), day_status (HrLite::DayStatus), link_builder (optional lambda date -> url) %>
<% first = month.beginning_of_month
   last = month.end_of_month
   link_builder = local_assigns[:link_builder]
   # kind => [code, word, cell modifier]: the code keeps a state readable without its colour.
   states = {
     present: [ "P", "Present", "present" ], half_day: [ "½", "Half day", "half" ],
     leave: [ "L", "Leave", "leave" ], half_day_leave: [ "½L", "Half-day leave", "half-leave" ],
     holiday: [ "H", "Holiday", "holiday" ], weekend: [ "WO", "Weekly off", "weekend" ],
     absent: [ "A", "Absent", "absent" ], upcoming: [ nil, "Upcoming", "muted" ]
   } %>
<div class="hrl-mgrid" role="group" aria-label="Attendance for <%= month.strftime('%B %Y') %>">
  <% %w[Mo Tu We Th Fr Sa Su].each do |d| %>
    <div class="hrl-mgrid__head"><%= d %></div>
  <% end %>
  <% (first.cwday - 1).times do %>
    <div></div>
  <% end %>
  <% (first..last).each do |date| %>
    <% day = day_status.for(date)
       # Today with no punch yet is not a lost day; only the views say so (payroll still reads DayStatus).
       code, word, mod = date == Date.current && day.kind == :absent ? [ "Today", "Today, not checked in yet", "today" ] : states[day.kind] %>
    <div class="<%= class_names("hrl-mgrid__day", "hrl-mgrid__day--#{mod}", "hrl-mgrid__day--today": date == Date.current) %>" role="group"
         aria-label="<%= date.strftime('%-d %b') %>, <%= word %><%= ', worked' if %i[holiday weekend].include?(day.kind) && day.record&.check_in_at %><%= ', Flagged' if day.record&.flagged? %>">
      <% if day.record&.flagged? %><span class="hrl-mgrid__flag" aria-hidden="true"></span><% end %>
      <span class="hrl-mgrid__num">
        <% if link_builder %>
          <a href="<%= link_builder.call(date) %>"><%= date.day %></a>
        <% else %>
          <%= date.day %>
        <% end %>
      </span>
      <% if code %><span class="hrl-mgrid__tag"><%= code %></span><% end %>
    </div>
  <% end %>
</div>
<div class="hrl-legend hrl-small">
  <% states.except(:upcoming).each_value do |code, word, mod| %>
    <span class="hrl-badge hrl-mgrid__key hrl-mgrid__day--<%= mod %>"><%= code %> <%= word %></span>
  <% end %>
  <span class="hrl-badge hrl-mgrid__key hrl-mgrid__day--today">Today</span>
  <span class="hrl-badge hrl-mgrid__key"><span class="hrl-mgrid__flag" aria-hidden="true"></span> Flagged</span>
  <span class="hrl-badge hrl-mgrid__key hrl-mgrid__day--muted">Upcoming</span>
</div>
