<%# locals: record (today's AttendanceRecord or nil) %>
<% status = HrLite::WorkStatus.for(hr_current_user.id)
   working = record&.check_in_at && !record.check_out_at
   timed = status.overlay&.until || (status.primary.until if status.primary.until.respond_to?(:hour)) %>
<div class="hrl-row hrl-row--mb hrl-small" role="status">
  <span class="hrl-modes"><%= hrl_status_icons(status) %></span>
  <span><strong><%= status.primary.label %></strong><% if status.overlay %> · <%= status.overlay.label %><% end %></span>
  <% if status.primary.source == "system" && !status.overlay %><span class="hrl-muted">(automatic)</span><% end %>
  <% if timed %>
    <span class="hrl-muted">until <%= timed.strftime("%H:%M") %> ·
      <span data-hrl-countdown="<%= timed.iso8601 %>"><%= hrl_duration([ timed - Time.current, 0 ].max) %> left</span></span>
  <% end %>
</div>
<%= render "hr_lite/attendance/custom_status", status: status %>
<%= render "hr_lite/attendance/calendar_connection" %>
<% if status.half_day_leave %><p class="hrl-small hrl-muted">Half-day leave today (<%= status.half_day_leave.half_day_part || "half day" %>).</p><% end %>

<% if working %>
  <% if status.overlay %>
    <%= button_to "End #{status.overlay.label.downcase} now", hr_lite.end_overlay_work_mode_path, method: :post, class: "hrl-btn hrl-btn--block" %>
  <% end %>
  <details>
    <summary class="hrl-btn hrl-btn--block">Change my mode</summary>
    <div class="hrl-mode-switch">
      <%= button_to hr_lite.work_mode_path, params: { mode: "office" }, method: :post, class: "hrl-btn hrl-btn--block" do %>
        <%= hrl_mode_icon(HrLite::WorkStatus::Entry.new(mode: "office", label: HrLite::WorkModeEvent.label("office"))) %>
        <%= HrLite::WorkModeEvent.label("office") %>
      <% end %>
      <% if HrLite::WfhRequest.approved_for(hr_current_user.id, Date.current) || HrLite::EmployeeProfile.where(user_id: hr_current_user.id).pick(:permanent_wfh) %>
        <%= button_to "Work from home", hr_lite.work_mode_path, params: { mode: "wfh" }, method: :post, class: "hrl-btn hrl-btn--block" %>
      <% end %>
      <%# Breaks: one tap for the full limit, or pick a shorter length when the limit allows a choice. %>
      <% %w[lunch short_break].each do |mode| %>
        <% if HrLite::WorkModeSwitch.duration_choices(mode).size > 1 %>
          <details>
            <summary class="hrl-btn hrl-btn--block"><%= HrLite::WorkModeEvent.label(mode) %></summary>
            <%= form_with url: hr_lite.work_mode_path, method: :post, local: true do %>
              <input type="hidden" name="mode" value="<%= mode %>">
              <%= render "hr_lite/attendance/duration_chips", mode: mode, id: "dur-#{mode}" %>
              <button type="submit" class="hrl-btn hrl-btn--primary">Start <%= HrLite::WorkModeEvent.label(mode).downcase %></button>
            <% end %>
          </details>
        <% else %>
          <%= button_to hr_lite.work_mode_path, params: { mode: mode }, method: :post, class: "hrl-btn hrl-btn--block" do %>
            <%= hrl_mode_icon(HrLite::WorkStatus::Entry.new(mode: mode, label: HrLite::WorkModeEvent.label(mode))) %>
            <%= HrLite::WorkModeEvent.label(mode) %>
          <% end %>
        <% end %>
      <% end %>

      <details>
        <summary class="hrl-btn hrl-btn--block">Busy / focus</summary>
        <%= form_with url: hr_lite.work_mode_path, method: :post, local: true do %>
          <input type="hidden" name="mode" value="busy">
          <%= render "hr_lite/attendance/duration_chips", mode: "busy", id: "dur-busy" %>
          <button type="submit" class="hrl-btn hrl-btn--primary">Set busy</button>
        <% end %>
      </details>
      <details>
        <summary class="hrl-btn hrl-btn--block">Meeting</summary>
        <%= form_with url: hr_lite.work_mode_path, method: :post, local: true do %>
          <input type="hidden" name="mode" value="meeting">
          <div class="hrl-field"><label for="mt-title">Meeting</label><input class="hrl-input" id="mt-title" name="title" maxlength="120" required></div>
          <div class="hrl-field"><label for="mt-client">Client (optional)</label><input class="hrl-input" id="mt-client" name="client" maxlength="120"></div>
          <%= render "hr_lite/attendance/crm_picker", id: "mt-crm" %>
          <%= render "hr_lite/attendance/duration_chips", mode: "meeting", id: "dur-meeting" %>
          <button type="submit" class="hrl-btn hrl-btn--primary">Start meeting</button>
        <% end %>
      </details>
      <details>
        <summary class="hrl-btn hrl-btn--block">Travelling</summary>
        <%= form_with url: hr_lite.work_mode_path, method: :post, local: true, data: { turbo_confirm: "Switch to Travelling?" } do %>
          <input type="hidden" name="mode" value="travelling">
          <div class="hrl-field"><label for="tr-dest">Going to</label><input class="hrl-input" id="tr-dest" name="destination" maxlength="120" required></div>
          <div class="hrl-field"><label for="tr-why">Purpose</label><input class="hrl-input" id="tr-why" name="title" maxlength="120" required></div>
          <div class="hrl-field"><label for="tr-client">Client (optional)</label><input class="hrl-input" id="tr-client" name="client" maxlength="120"></div>
          <%= render "hr_lite/attendance/crm_picker", id: "tr-crm" %>
          <%= render "hr_lite/attendance/duration_chips", mode: "travelling", id: "dur-travelling", optional: true %>
          <button type="submit" class="hrl-btn hrl-btn--primary">Start travelling</button>
        <% end %>
      </details>
      <details>
        <summary class="hrl-btn hrl-btn--block">Client meeting (outside)</summary>
        <%= form_with url: hr_lite.work_mode_path, method: :post, local: true, data: { turbo_confirm: "Switch to an outside-office meeting?" } do %>
          <input type="hidden" name="mode" value="outside_meeting">
          <%= render "hr_lite/attendance/crm_picker", id: "om-crm" %>
          <div class="hrl-field"><label for="om-client">Client or prospect<%= " (or link a lead above)" if HrLite.config.crm_search %></label><input class="hrl-input" id="om-client" name="client" maxlength="120"<%= " required" unless HrLite.config.crm_search %>></div>
          <div class="hrl-field"><label for="om-why">Purpose</label><input class="hrl-input" id="om-why" name="title" maxlength="120" required></div>
          <div class="hrl-field"><label for="om-where">Where (optional)</label><input class="hrl-input" id="om-where" name="destination" maxlength="120"></div>
          <%= render "hr_lite/attendance/duration_chips", mode: "outside_meeting", id: "dur-om", optional: true %>
          <button type="submit" class="hrl-btn hrl-btn--primary">Start client meeting</button>
        <% end %>
      </details>
      <details>
        <summary class="hrl-btn hrl-btn--block">Out of office</summary>
        <%= form_with url: hr_lite.work_mode_path, method: :post, local: true do %>
          <input type="hidden" name="mode" value="out_of_office">
          <div class="hrl-field"><label for="oo-why">Reason</label>
            <%= select_tag :category, options_for_select(HrLite::WorkModeSwitch::OUT_OF_OFFICE_REASONS.invert), id: "oo-why" %></div>
          <%= render "hr_lite/attendance/duration_chips", mode: "out_of_office", id: "dur-oo" %>
          <p class="hrl-small hrl-muted">Away for a full day? <a href="<%= hr_lite.new_leave_request_path %>">Apply for leave</a> instead.</p>
          <button type="submit" class="hrl-btn hrl-btn--primary">Set out of office</button>
        <% end %>
      </details>
    </div>
  </details>
<% end %>
