<% penalties = HrLite::AttendancePenalty.where(user_id: user.id, date: month.all_month).order(:date, :id) %>
<section class="hrl-card">
  <h2 class="hrl-card__title">Penalties in <%= month.strftime("%B") %></h2>
  <% if penalties.empty? %>
    <p class="hrl-card--empty">No penalties this month.</p>
  <% end %>
  <% penalties.each do |penalty| %>
    <div class="hrl-feed__item hrl-small">
      <div class="hrl-feed__body">
        <strong><%= penalty.date.strftime("%a %-d %b") %></strong> ·
        <span class="<%= class_names("hrl-badge", penalty.removed_at ? "hrl-badge--muted" : "hrl-badge--warn") %>">+<%= penalty.minutes %> min</span>
        <%= penalty.label %>
        <% if penalty.removed_at %>
          <div class="hrl-muted">Removed by HR: <%= penalty.removal_reason %></div>
        <% elsif local_assigns[:removable] %>
          <%= form_with url: hr_lite.remove_penalty_admin_attendance_path(user.id, penalty_id: penalty.id), method: :post, local: true, class: "hrl-row" do %>
            <label class="hrl-sr-only" for="hrl-remove-<%= penalty.id %>">Reason to remove</label>
            <input type="text" class="hrl-input" name="removal_reason" id="hrl-remove-<%= penalty.id %>" required placeholder="Reason to remove">
            <button type="submit" class="hrl-btn">Remove</button>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
