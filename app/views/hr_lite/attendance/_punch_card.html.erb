<% record = HrLite::AttendanceRecord.find_by(user_id: hr_current_user.id, date: Date.current) %>
<%# A shift that runs past midnight leaves yesterday's record open.
    AttendancePuncher already closes it, but this card looked only at today,
    so after midnight it offered "Check in" and the night's punch never
    closed — no worked duration, no hours on the team board. %>
<% open_yesterday = record ? nil : HrLite::AttendanceRecord.for_date(Date.current - 1)
                                                          .missing_checkout
                                                          .find_by(user_id: hr_current_user.id) %>
<section class="hrl-card">
  <h2 class="hrl-card__title">Today, <%= Date.current.strftime("%d %b") %></h2>

  <div class="hrl-row hrl-row--mb hrl-small">
    <% if record&.check_in_at && !record.check_out_at %>
      <span class="hrl-badge hrl-badge--ok">In since <%= record.check_in_at.strftime("%H:%M") %> · <%= hrl_duration(Time.current - record.check_in_at) %> so far</span>
    <% elsif record&.check_in_at %>
      <span class="hrl-badge hrl-badge--ok">In <%= record.check_in_at.strftime("%H:%M") %></span>
    <% end %>
    <% if record&.check_out_at %>
      <span class="hrl-badge hrl-badge--muted">Out <%= record.check_out_at.strftime("%H:%M") %></span>
    <% end %>
    <% if record&.work_mode_label %>
      <span class="hrl-badge hrl-badge--ok"><%= record.work_mode_label %></span>
    <% end %>
    <% if record&.check_in_place == "home" && record.work_location %>
      <span class="hrl-badge hrl-badge--muted"><%= record.work_location.name %> · <%= HrLite::WorkLocation::FENCE_M %> m</span>
    <% end %>
    <% if record&.flagged? %>
      <span class="hrl-badge hrl-badge--bad">Flagged</span>
    <% end %>
    <% if open_yesterday %>
      <span class="hrl-badge hrl-badge--warn">Yesterday still open —
        in <%= open_yesterday.check_in_at.strftime("%H:%M") %></span>
    <% elsif record.nil? %>
      <span class="hrl-muted">Not checked in yet.</span>
    <% end %>
  </div>
  <% if HrLite.config.attendance_slots %>
    <%= render "hr_lite/attendance/slot", record: record %>
  <% end %>
  <% if HrLite.config.office_geofence %>
    <%= render "hr_lite/attendance/work_mode", record: record %>
  <% end %>
  <% if record&.flagged? %>
    <p class="hrl-small">Flagged: <%= record.flag_note %></p>
  <% end %>

  <% if open_yesterday %>
    <%= form_with url: hr_lite.check_out_attendance_path, method: :post, local: true,
                  html: { data: { "hrl-geo-punch": true, "hrl-geo-required": HrLite.config.require_punch_location.presence } } do %>
      <input type="hidden" name="lat"><input type="hidden" name="lng">
      <input type="hidden" name="accuracy_m"><input type="hidden" name="geo_status">
      <button type="submit" class="hrl-btn hrl-btn--big hrl-btn--block">
        Check out yesterday's shift
      </button>
      <p class="hrl-small hrl-muted" data-hrl-geo-status role="status" aria-live="polite"></p>
    <% end %>
  <% elsif record&.check_in_at.blank? %>
    <%= form_with url: hr_lite.check_in_attendance_path, method: :post, local: true,
                  html: { data: { "hrl-geo-punch": true, "hrl-geo-required": HrLite.config.require_punch_location.presence } } do %>
      <input type="hidden" name="lat"><input type="hidden" name="lng">
      <input type="hidden" name="accuracy_m"><input type="hidden" name="geo_status">
      <% if HrLite.config.office_geofence && HrLite::EmployeeProfile.where(user_id: hr_current_user.id).pick(:field_staff) %>
        <details>
          <summary class="hrl-btn hrl-btn--block">Checking in from the field?</summary>
          <fieldset class="hrl-field">
            <legend class="hrl-small">Where are you?</legend>
            <label class="hrl-field--check"><input type="radio" name="field[mode]" value="travelling"> Travelling</label>
            <label class="hrl-field--check"><input type="radio" name="field[mode]" value="outside_meeting"> Client meeting</label>
          </fieldset>
          <div class="hrl-field"><label for="field-purpose">Purpose</label><input type="text" class="hrl-input" id="field-purpose" name="field[purpose]" maxlength="120"></div>
          <div class="hrl-field"><label for="field-place">Destination or client</label><input type="text" class="hrl-input" id="field-place" name="field[place]" maxlength="120"></div>
        </details>
      <% end %>
      <% if flash[:punch_offer] == "home" %>
        <fieldset class="hrl-field">
          <legend class="hrl-small">Is this your home location?</legend>
          <% if HrLite::WorkLocation.live.where(user_id: hr_current_user.id).count < HrLite::WorkLocation::MAX_LIVE %>
            <label class="hrl-field--check"><input type="radio" name="place" value="home" required> Yes, save this place as a home location</label>
          <% else %>
            <p class="hrl-small"><%= HrLite::WorkLocationsController::CAP_MESSAGE %></p>
          <% end %>
          <label class="hrl-field--check"><input type="radio" name="place" value="travel" required> No, I am travelling</label>
        </fieldset>
      <% end %>
      <button type="submit" class="hrl-btn hrl-btn--primary hrl-btn--big hrl-btn--block">Check in</button>
      <p class="hrl-small hrl-muted" data-hrl-geo-status role="status" aria-live="polite"></p>
    <% end %>
  <% else %>
    <%= form_with url: hr_lite.check_out_attendance_path, method: :post, local: true,
                  html: { data: { "hrl-geo-punch": true, "hrl-geo-required": HrLite.config.require_punch_location.presence } } do %>
      <input type="hidden" name="lat"><input type="hidden" name="lng">
      <input type="hidden" name="accuracy_m"><input type="hidden" name="geo_status">
      <% if flash[:punch_offer] == "travel" %>
        <div class="hrl-field"><label class="hrl-field--check"><input type="checkbox" name="place" value="travel" required> I am travelling — check out here</label></div>
      <% end %>
      <button type="submit" class="hrl-btn hrl-btn--big hrl-btn--block">
        <%= record.check_out_at ? "Update check-out" : "Check out" %>
      </button>
      <p class="hrl-small hrl-muted" data-hrl-geo-status role="status" aria-live="polite"></p>
    <% end %>
  <% end %>

  <% if local_assigns[:attention].present? %><p class="hrl-small hrl-muted hrl-mt">Needs a fix</p><% end %>
  <% local_assigns[:attention]&.each do |date, reason| %>
    <div class="hrl-feed__item hrl-row">
      <div class="hrl-feed__body"><%= date.strftime("%a %-d %b") %> · <%= reason %></div>
      <a class="hrl-btn" href="<%= hr_lite.new_regularization_request_path(date: date) %>">Fix<span class="hrl-sr-only"> <%= date.strftime("%a %-d %b") %></span></a>
    </div>
  <% end %>

  <%# Links wrap as whole items; no separator dots left dangling at a line end. %>
  <div class="hrl-links">
    <a class="hrl-card__link" href="<%= hr_lite.attendance_path %>">View my month</a>
    <% if HrLite.config.office_geofence %>
      <a class="hrl-card__link" href="<%= hr_lite.wfh_requests_path %>">Work from home</a>
      <a class="hrl-card__link" href="<%= hr_lite.work_locations_path %>">WFH locations</a>
      <a class="hrl-card__link" href="<%= hr_lite.work_time_path %>">My work time</a>
    <% end %>
  </div>

  <% if local_assigns.key?(:attention) %>
    <div class="hrl-row">
      <a class="hrl-btn" href="<%= hr_lite.new_leave_request_path %>">Apply leave</a>
      <% if HrLite.config.office_geofence %><a class="hrl-btn" href="<%= hr_lite.wfh_requests_path %>">Request WFH</a><% end %>
      <a class="hrl-btn" href="<%= hr_lite.new_regularization_request_path %>">Fix a punch</a>
      <a class="hrl-btn" href="<%= hr_lite.new_comp_off_request_path %>">Comp-off</a>
      <% if hr_lite_route?(:salary_slips_path) %><a class="hrl-btn" href="<%= hr_lite.salary_slips_path %>">Payslip</a><% end %>
    </div>
  <% end %>
</section>
