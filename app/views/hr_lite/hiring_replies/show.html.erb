<% campaign = @candidate.campaign %>
<% round = @reply.round %>
<% content_for(:page_title) { campaign.position } %>
<div class="hrl-page__head">
  <h1 class="hrl-page__title"><%= campaign.position %></h1>
  <p class="hrl-page__sub">This form is for <strong><%= @candidate.name %></strong>. Hi <%= @candidate.first_name %>, <%= round == 1 ? "thank you for your interest." : "congratulations on reaching round #{round}." %></p>
</div>

<% if @reply.responded_at %>
  <section class="hrl-card">
    <h2 class="hrl-card__title">Thanks, we have your answers</h2>
    <% if @reply.answers["interested"] == "no" %>
      <p>We have noted that you do not want to go ahead. All the best.</p>
    <% else %>
      <% if (turn = @reply.turn_label) %><p>Your round <%= round %> interview time: <strong><%= @reply.preferred_date.strftime("%A, %-d %B") %>, <%= turn %></strong>.</p><% end %>
      <p>Our HR team will call you to confirm it.</p>
    <% end %>
  </section>
<% else %>
  <%= form_with url: hr_lite.hiring_reply_path(@reply.token), method: :post, local: true, multipart: true do %>
    <% if round == 1 %>
      <section class="hrl-card">
        <fieldset class="hrl-field">
          <legend><strong>Do you want to go ahead with the interview?</strong></legend>
          <label class="hrl-field--check"><input type="radio" name="interested" value="yes" required <%= "checked" if params[:interested] == "yes" %>> Yes, I am interested</label>
          <label class="hrl-field--check"><input type="radio" name="interested" value="no" <%= "checked" if params[:interested] == "no" %>> No, not now</label>
        </fieldset>
      </section>
    <% end %>

    <section class="hrl-card">
      <h2 class="hrl-card__title"><%= round == 1 ? "If yes: pick" : "Pick" %> a day and one time slot for round <%= round %></h2>
      <p class="hrl-small hrl-muted">Each 2-hour slot takes up to 4 people. You get your own 30-minute interview time inside it, in the order you book. HR will call you to confirm.</p>
      <% HrLite::HiringReply.open_slots(allow_sunday: campaign.allow_sunday).each do |day, slots| %>
        <fieldset class="hrl-field">
          <legend><%= day.strftime("%A, %-d %B") %></legend>
          <% if slots.empty? %>
            <p class="hrl-small hrl-muted">Fully booked</p>
          <% else %>
            <% slots.each do |slot| %>
              <% value = "#{day.iso8601}|#{slot}" %>
              <label class="hrl-field--check"><input type="radio" name="pick" value="<%= value %>" <%= "checked" if params[:pick] == value %>> <%= HrLite::HiringReply::SLOTS[slot] %></label>
            <% end %>
          <% end %>
        </fieldset>
      <% end %>
      <div class="hrl-field">
        <label for="alternate_phone">Alternate phone number (optional)</label>
        <input type="tel" name="alternate_phone" id="alternate_phone" inputmode="tel" autocomplete="tel" value="<%= params[:alternate_phone] %>">
      </div>
    </section>

    <% if round == 1 %>
      <section class="hrl-card">
        <fieldset class="hrl-field">
          <legend>How soon can you join?</legend>
          <% HrLite::HiringReply::JOINING.each do |key, label| %>
            <label class="hrl-field--check"><input type="radio" name="joining" value="<%= key %>" <%= "checked" if params[:joining] == key %>> <%= label %></label>
          <% end %>
        </fieldset>
        <% { "stipend_ok" => "Are you fine with the monthly stipend#{" of #{campaign.stipend}" if campaign.stipend.present?}?",
             "location_ok" => "Can you work from our office#{" at #{campaign.location}" if campaign.location.present?}?",
             "schedule_ok" => "Are you fine with the work schedule#{": #{campaign.schedule}" if campaign.schedule.present?}?",
             "programme_ok" => "Can you commit to the full programme#{" (#{campaign.programme})" if campaign.programme.present?}?" }.each do |key, question| %>
          <fieldset class="hrl-field">
            <legend><%= question %></legend>
            <label class="hrl-field--check"><input type="radio" name="<%= key %>" value="yes" <%= "checked" if params[key] == "yes" %>> Yes</label>
            <label class="hrl-field--check"><input type="radio" name="<%= key %>" value="no" <%= "checked" if params[key] == "no" %>> No</label>
          </fieldset>
        <% end %>
      </section>
    <% end %>

    <% if round == 3 %>
      <section class="hrl-card">
        <h2 class="hrl-card__title">Joining details</h2>
        <p class="hrl-small hrl-muted">Stored encrypted. Only our HR team can see them.</p>
        <div class="hrl-field">
          <label for="aadhaar_number">Aadhaar number</label>
          <input type="text" name="aadhaar_number" id="aadhaar_number" inputmode="numeric" autocomplete="off" maxlength="14" required>
        </div>
        <div class="hrl-field">
          <label for="pan_number">PAN</label>
          <input type="text" name="pan_number" id="pan_number" autocomplete="off" maxlength="10" autocapitalize="characters">
        </div>
        <label class="hrl-field--check"><input type="checkbox" name="pan_pending" value="1" <%= "checked" if params[:pan_pending] == "1" %>> I don't have a PAN yet (HR will ask for it when you join)</label>
        <label class="hrl-field--check"><input type="checkbox" name="no_salary_slips" value="1" <%= "checked" if params[:no_salary_slips] == "1" %>> I have no salary slips (fresher)</label>
      </section>
    <% end %>

    <% kinds = HrLite::HiringReply::DOCUMENTS.fetch(round, {}) %>
    <% if kinds.any? %>
      <section class="hrl-card">
        <h2 class="hrl-card__title">Your documents</h2>
        <p class="hrl-small hrl-muted">PDF, JPG or PNG, up to 5 MB each. Stored encrypted.<%= " Skip PAN or salary slips if you ticked the box above." if round == 3 %></p>
        <% kinds.each do |kind, label| %>
          <div class="hrl-field">
            <label for="doc_<%= kind %>"><%= label %><%= " (if you have it)" if kind.start_with?("salary_slip", "pan") %></label>
            <input type="file" name="documents[<%= kind %>]" id="doc_<%= kind %>" accept=".pdf,.jpg,.jpeg,.png" <%= "required" unless kind.start_with?("salary_slip", "pan") %>>
          </div>
        <% end %>
      </section>
    <% end %>

    <% if round == 3 %>
      <label class="hrl-field--check"><input type="checkbox" name="consent" value="1" required> I agree to share these details and documents with <%= HrLite.config.company.call[:brand].presence || "the company" %> for hiring and joining.</label>
    <% end %>

    <div class="hrl-form-actions"><button class="hrl-btn hrl-btn--primary" type="submit">Send my answers</button></div>
  <% end %>
<% end %>
