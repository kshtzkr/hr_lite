<%# locals: user (default: you), compact, bare (no card of its own — sits inside another card) %>
<% user = local_assigns[:user] || hr_current_user %>
<%= tag.send(local_assigns[:bare] ? :div : :section, class: ("hrl-card" unless local_assigns[:bare])) do %>
  <%= tag.send(local_assigns[:bare] ? :h3 : :h2, class: "hrl-card__title") do %>Leave balance <%= HrLite::LeaveYear.label(HrLite::LeaveYear.current_key) %><% end %>
  <% types = HrLite::LeaveType.active.where(paid: true).where.not(annual_quota: nil) %>
  <% if types.any? %>
    <div class="hrl-row">
      <% types.each do |type| %>
        <% balance = HrLite::LeaveBalance.for(user, type, HrLite::LeaveYear.current_key) %>
        <% pending = HrLite::LeaveRequest.pending.where(user_id: user.id, leave_type_id: type.id, start_date: HrLite::LeaveYear.range(HrLite::LeaveYear.current_key)).sum(&:days_count) %>
        <span class="hrl-badge hrl-badge--type" style="--hrl-type: <%= type.color %>">
          <%= type.name %> · <%= hrl_days(balance.available) %> of <%= hrl_days(balance.entitled) %> left<% if pending.positive? %> · <%= hrl_days(pending) %> pending<% end %><% if (held = balance.penalty_days).positive? %> · <%= hrl_days(held) %> held for penalties<% end %>
        </span>
      <% end %>
    </div>
    <% unless local_assigns[:compact] %>
      <a class="hrl-btn hrl-mt" href="<%= hr_lite.new_leave_request_path %>">Apply for leave</a>
    <% end %>
  <% else %>
    <p class="hrl-muted hrl-small">No leave types configured yet.</p>
  <% end %>
<% end %>
