<section class="hrl-card">
  <h2 class="hrl-card__title">Leave balance <%= HrLite::LeaveYear.label(HrLite::LeaveYear.current_key) %></h2>
  <% types = HrLite::LeaveType.active.where(paid: true).where.not(annual_quota: nil) %>
  <% if types.any? %>
    <div class="hrl-row">
      <% types.each do |type| %>
        <% balance = HrLite::LeaveBalance.for(hr_current_user, type, HrLite::LeaveYear.current_key) %>
        <span class="hrl-badge hrl-badge--type" style="--hrl-type: <%= type.color %>">
          <%= type.name %> · <%= hrl_days(balance.available) %> of <%= hrl_days(balance.entitled) %> left
        </span>
      <% end %>
    </div>
    <% unless local_assigns[:compact] %>
      <a class="hrl-btn hrl-mt" href="<%= hr_lite.new_leave_request_path %>">Apply for leave</a>
    <% end %>
  <% else %>
    <p class="hrl-muted hrl-small">No leave types configured yet.</p>
  <% end %>
</section>
