<% content_for(:page_title) { "Leaves" } %>
<div class="hrl-page__head">
  <h1 class="hrl-page__title">My leaves</h1>
  <div class="hrl-page__actions">
    <a class="hrl-btn" href="<%= hr_lite.leave_balances_path %>">Balances</a>
    <a class="hrl-btn" href="<%= hr_lite.comp_off_requests_path %>">Comp-off</a>
    <% if hr_can?("leave.approve", scope: :team) %>
      <a class="hrl-btn" href="<%= hr_lite.new_admin_leave_request_path %>">Record leave for someone</a>
    <% end %>
    <a class="hrl-btn hrl-btn--primary" href="<%= hr_lite.new_leave_request_path %>">Apply</a>
  </div>
</div>

<%= render "hr_lite/leave_requests/balance_chips", compact: true %>

<section class="hrl-card">
  <% if @requests.any? %>
    <% @requests.each do |request| %>
      <a class="hrl-listrow" href="<%= hr_lite.leave_request_path(request) %>">
        <span><span class="hrl-badge hrl-badge--type" style="--hrl-type: <%= request.leave_type.color %>"><%= request.leave_type.code %></span> <%= request.leave_type.name %></span>
        <%= hrl_request_status_badge(request.status) %>
        <span class="hrl-small hrl-muted"><%= request.date_range_label %> · <%= pluralize(hrl_days(request.days_count), "day") %></span>
      </a>
    <% end %>
    <%= hrl_pagination %>
  <% else %>
    <p class="hrl-card--empty">No leave requests yet.</p>
  <% end %>
</section>
