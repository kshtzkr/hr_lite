<% content_for(:page_title) { "Timeline — #{hr_display_name(@person)}" } %>
<% year_path = ->(y) { @person.id == hr_current_user.id ? hr_lite.timeline_path(year: y) : hr_lite.person_timeline_path(@person.id, year: y) } %>
<% name = hr_display_name(@person) %>
<div class="hrl-page__head">
  <h1 class="hrl-page__title"><%= name %></h1>
</div>

<section class="hrl-card">
  <dl class="hrl-deflist">
    <% if @profile&.designation.present? %><dt>Role</dt><dd><%= @profile.designation %></dd><% end %>
    <% if @profile&.department.present? %><dt>Department</dt><dd><%= @profile.department %></dd><% end %>
    <% if @profile %>
      <dt>Joined</dt><dd><%= @profile.date_of_joining.strftime("%-d %B %Y") %>
        <% unless @profile.date_of_exit && @profile.date_of_exit <= Date.current %><span class="hrl-muted">· <%= distance_of_time_in_words(@profile.date_of_joining, Date.current) %></span><% end %></dd>
    <% end %>
  </dl>
  <div class="hrl-row hrl-mt">
    <a class="hrl-btn" href="<%= year_path.(@year - 1) %>">&larr; <%= @year - 1 %></a>
    <strong><%= @year %></strong>
    <a class="hrl-btn" href="<%= year_path.(@year + 1) %>"><%= @year + 1 %> &rarr;</a>
  </div>
</section>

<section class="hrl-card">
  <h2 class="hrl-card__title">Public timeline</h2>
  <p class="hrl-small hrl-muted">Everyone at the company can see this.</p>
  <%= render "events", events: @public_events, empty: "Nothing public in #{@year}." %>
</section>

<% if @private_card %>
  <section class="hrl-card hrl-card--private" aria-labelledby="private-records">
    <h2 class="hrl-card__title" id="private-records">Private records</h2>
    <p class="hrl-small"><strong>Private</strong> — only <%= @person.id == hr_current_user.id ? "you" : name %> and people with access can see this.</p>
    <% if @show_balance %><%= render "hr_lite/leave_requests/balance_chips", user: @person, compact: true, bare: true %><% end %>
    <%= render "events", events: @private_events, empty: "Nothing private in #{@year}." %>
  </section>
<% end %>
