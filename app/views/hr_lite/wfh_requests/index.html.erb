<% content_for(:page_title) { "Work from home" } %>
<% content_for(:back, "Attendance") %>
<div class="hrl-page__head">
  <h1 class="hrl-page__title">Work from home</h1>
</div>

<section class="hrl-card">
  <h2 class="hrl-card__title">Request WFH</h2>
  <p class="hrl-small hrl-muted">Pick dates from today up to <%= HrLite::WfhRequest::MAX_DAYS_AHEAD %> days ahead. HR approves or rejects; only approved dates let you check in away from the office.</p>
  <%= form_with model: @request, url: hr_lite.wfh_requests_path, scope: :wfh_request, local: true do |f| %>
    <%= render "hr_lite/shared/form_errors", record: @request %>
    <% min, max = @window.first.iso8601, @window.last.iso8601 %>
    <div class="hrl-field"><%= f.label :start_date, "From" %><%= f.date_field :start_date, min: min, max: max, required: true %></div>
    <div class="hrl-field"><%= f.label :end_date, "To (same day for one day)" %><%= f.date_field :end_date, min: min, max: max, required: true %></div>
    <div class="hrl-field"><%= f.label :reason, "Why do you need WFH?" %><%= f.text_area :reason, rows: 3, required: true %></div>
    <div class="hrl-form-actions"><%= f.submit "Send to HR", class: "hrl-btn hrl-btn--primary" %></div>
  <% end %>
</section>

<section class="hrl-card">
  <h2 class="hrl-card__title">Next <%= HrLite::WfhRequest::MAX_DAYS_AHEAD %> days</h2>
  <% marks = { "approved" => [ "WFH", "Approved", "present" ], "pending" => [ "Pend", "Pending", "pending" ], "rejected" => [ "Rej", "Rejected", "absent" ] } %>
  <div class="hrl-mgrid" role="group" aria-label="Your WFH dates">
    <% %w[Mo Tu We Th Fr Sa Su].each do |d| %><div class="hrl-mgrid__head"><%= d %></div><% end %>
    <% (@window.first.cwday - 1).times do %><div></div><% end %>
    <% @window.each do |date| %>
      <% code, word, mod = marks[@day_status[date]] %>
      <div class="<%= class_names("hrl-mgrid__day", "hrl-mgrid__day--#{mod}": mod, "hrl-mgrid__day--today": date == Date.current) %>"
           role="group" aria-label="<%= date.strftime('%-d %b') %><%= ", #{word}" if word %>">
        <span class="hrl-mgrid__num"><%= date.day %></span>
        <% if code %><span class="hrl-mgrid__tag"><%= code %></span><% end %>
      </div>
    <% end %>
  </div>
  <div class="hrl-legend hrl-small">
    <% marks.each_value do |_code, word, mod| %>
      <span class="hrl-badge hrl-mgrid__key hrl-mgrid__day--<%= mod %>"><%= word %></span>
    <% end %>
  </div>
</section>

<section class="hrl-card">
  <h2 class="hrl-card__title">My requests</h2>
  <% if @requests.any? %>
    <div class="hrl-table-wrap">
      <table class="hrl-table hrl-table--stack">
        <thead><tr><th>Dates</th><th>Reason</th><th>Status</th><th>HR remarks</th><th></th></tr></thead>
        <tbody>
          <% @requests.each do |request| %>
            <tr>
              <td data-label="Dates"><%= request.dates_label %> <span class="hrl-small hrl-muted">· <%= pluralize(request.days, "day") %></span></td>
              <td data-label="Reason"><%= request.reason %></td>
              <td data-label="Status"><%= hrl_request_status_badge(request.status) %></td>
              <td data-label="HR remarks" class="hrl-small hrl-muted"><%= request.decision_note.presence || "—" %></td>
              <td data-label="" class="<%= 'hrl-cell--void' unless request.pending? %>">
                <% if request.pending? %>
                  <%= button_to "Cancel", hr_lite.cancel_wfh_request_path(request), method: :post,
                                class: "hrl-btn hrl-btn--danger", form: { data: { turbo_confirm: "Cancel this request?" } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= hrl_pagination %>
  <% else %>
    <p class="hrl-card--empty">No WFH requests yet.</p>
  <% end %>
</section>
