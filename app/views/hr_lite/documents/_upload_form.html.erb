<%# locals: document, url (where it posts), open (start expanded) — one upload form for My documents and HR's view of a person. %>
<details class="hrl-card" <%= "open" if open || document.errors.any? %>>
  <summary class="hrl-btn">Upload a document</summary>
  <%= form_with model: document, url: url, method: :post, local: true, class: "hrl-mt" do |f| %>
    <%= render "hr_lite/shared/form_errors", record: document %>
    <div class="hrl-field">
      <%= f.label :category, id: "hrl-doc-category", for: nil %>
      <div class="hrl-chiprow" role="radiogroup" aria-labelledby="hrl-doc-category">
        <% (HrLite::Document::SENSITIVE_CATEGORIES.map { |c| [ c.humanize.sub(/\APan\z/, "PAN"), c ] } +
            [ [ "Offer letter", "offer_letter" ], [ "Certificate", "certificate" ], [ "Other", "other" ] ]).each do |label, value| %>
          <label><%= f.radio_button :category, value, required: true %><span><%= label %></span></label>
        <% end %>
      </div>
    </div>
    <div class="hrl-field"><%= f.label :title %><%= f.text_field :title, required: true %></div>
    <div class="hrl-field">
      <%= f.label :reference_number, "Document number (optional)" %>
      <%= f.text_field :reference_number %>
    </div>
    <div class="hrl-field">
      <%= f.label :expires_on, "Expires on (optional — we will remind you)" %>
      <%= f.date_field :expires_on %>
    </div>
    <div class="hrl-field">
      <%= f.label :file, "File (PDF or image, up to 10 MB)" %>
      <%= f.file_field :file, required: true, accept: "application/pdf,image/*" %>
    </div>
    <div class="hrl-form-actions"><%= f.submit "Upload", class: "hrl-btn hrl-btn--primary" %></div>
  <% end %>
</details>
