<section class="hrl-card">
  <h2 class="hrl-card__title">Upcoming holidays</h2>
  <% holidays = HrLite::Holiday.company_wide.upcoming.where(date: ..Date.current + 60).limit(3).to_a %>
  <% if holidays.any? %>
    <div class="hrl-feed">
      <% holidays.each do |holiday| %>
        <% days = (holiday.date - Date.current).to_i %>
        <div class="hrl-feed__item"><div class="hrl-feed__body"><%= holiday.date.strftime("%a %-d %b") %> · <%= holiday.name %> · <%= days.zero? ? "today" : "in #{pluralize(days, "day")}" %></div></div>
      <% end %>
    </div>
  <% else %>
    <p class="hrl-muted hrl-small">No holidays in the next 2 months.</p>
  <% end %>
  <a class="hrl-card__link" href="<%= hr_lite.holidays_path %>">All holidays</a>
</section>
