<% content_for(:page_title) { "WFH — #{hr_display_name(@request.user)}" } %>
<a class="hrl-backlink" href="<%= hr_lite.admin_wfh_requests_path %>"><span aria-hidden="true">‹</span> Approvals</a>
<div class="hrl-page__head">
  <h1 class="hrl-page__title">WFH — <%= hr_display_name(@request.user) %></h1>
</div>

<section class="hrl-card">
  <dl class="hrl-deflist">
    <dt>Dates</dt><dd><%= @request.dates_label %> (<%= pluralize(@request.days, "day") %>)</dd>
    <dt>Reason</dt><dd><%= @request.reason %></dd>
    <dt>Submitted</dt><dd><%= @request.created_at.strftime("%d %b %Y %H:%M") %></dd>
    <dt>Status</dt><dd><%= hrl_request_status_badge(@request.status) %></dd>
    <% if @request.decided_at %>
      <dt>Decided</dt>
      <dd><%= hr_display_name(@request.decided_by) %> · <%= @request.decided_at.strftime("%d %b %H:%M") %>
        <% if @request.decision_note.present? %> · <%= @request.decision_note %><% end %></dd>
    <% end %>
  </dl>
  <a class="hrl-card__link" href="<%= hr_lite.admin_attendance_path(@request.user_id, month: @request.start_date.strftime("%Y-%m")) %>">Their month</a>
</section>

<% if @request.pending? && @decidable %>
  <%# Two forms: Rails binds the CSRF token to each form's own action. %>
  <section class="hrl-card">
    <h2 class="hrl-card__title">Approve</h2>
    <%= form_with url: hr_lite.approve_admin_wfh_request_path(@request), method: :post, local: true do |f| %>
      <div class="hrl-field"><%= f.label :decision_note, "Remark (optional)", for: "approve_note" %><%= f.text_area :decision_note, id: "approve_note" %></div>
      <div class="hrl-form-actions"><%= f.button "Approve WFH", type: :submit, class: "hrl-btn hrl-btn--primary" %></div>
    <% end %>
  </section>
  <section class="hrl-card">
    <h2 class="hrl-card__title">Reject</h2>
    <%= form_with url: hr_lite.reject_admin_wfh_request_path(@request), method: :post, local: true do |f| %>
      <div class="hrl-field"><%= f.label :decision_note, "Remark (required)", for: "reject_note" %><%= f.text_area :decision_note, id: "reject_note", required: true %></div>
      <div class="hrl-form-actions"><%= f.button "Reject", type: :submit, class: "hrl-btn hrl-btn--danger" %></div>
    <% end %>
  </section>
<% end %>

<% if @decidable && (@request.approved? || @request.rejected?) %>
  <section class="hrl-card">
    <h2 class="hrl-card__title">Change this WFH</h2>
    <%= form_with url: hr_lite.admin_wfh_request_path(@request), method: :patch, local: true do |f| %>
      <div class="hrl-field"><%= f.label :start_date, "From" %><%= f.date_field :start_date, value: @request.start_date, required: true %></div>
      <div class="hrl-field"><%= f.label :end_date, "To" %><%= f.date_field :end_date, value: @request.end_date, required: true %></div>
      <fieldset class="hrl-field">
        <legend class="hrl-small">Decision</legend>
        <label class="hrl-field--check"><%= f.radio_button :status, "approved", checked: @request.approved? %> Approved</label>
        <label class="hrl-field--check"><%= f.radio_button :status, "rejected", checked: @request.rejected? %> Rejected</label>
      </fieldset>
      <div class="hrl-field"><%= f.label :decision_note, "Reason for the change (required)", for: "change_note" %><%= f.text_area :decision_note, id: "change_note", required: true %></div>
      <div class="hrl-form-actions"><%= f.button "Save change", type: :submit, class: "hrl-btn hrl-btn--primary" %></div>
    <% end %>
  </section>
<% end %>
