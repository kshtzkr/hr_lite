<% content_for(:page_title) { "Record leave" } %>
<div class="hrl-page__head">
  <h1 class="hrl-page__title">Record leave for an employee</h1>
  <p class="hrl-page__sub">For leave somebody took but never applied for. It is saved as approved, and they get an email.</p>
</div>

<section class="hrl-card">
  <%= form_with model: @request, url: hr_lite.admin_leave_requests_path, method: :post, local: true do |f| %>
    <%= render "hr_lite/shared/form_errors", record: @request %>
    <div class="hrl-field">
      <%= label_tag :employee_code, "Employee (type a name or code)" %>
      <%= text_field_tag :employee_code, params[:employee_code], list: "hrl-employees", required: true, autocomplete: "off", placeholder: "Start typing a name or code…" %>
      <datalist id="hrl-employees">
        <% @people.each do |p| %>
          <option value="<%= p.employee_code %>"><%= hr_display_name(p.user) %></option>
        <% end %>
      </datalist>
      <p class="hrl-small hrl-muted">Someone missing? Only people with an HR profile are listed.
        <% if hr_leadership? %>
          <a href="<%= hr_lite.admin_employees_path %>">Set up their profile</a>
        <% else %>
          Ask leadership to set up their HR profile.
        <% end %>
      </p>
    </div>
    <div class="hrl-field">
      <%= f.label :leave_type_id, "Type" %>
      <%= f.collection_select :leave_type_id, HrLite::LeaveType.active, :id, :name %>
    </div>
    <div class="hrl-field"><%= f.label :start_date, "From" %><%= f.date_field :start_date %></div>
    <div class="hrl-field"><%= f.label :end_date, "To" %><%= f.date_field :end_date %></div>
    <div class="hrl-field hrl-field--check">
      <%= f.check_box :half_day %>
      <%= f.label :half_day, "Half day (single-day only)" %>
    </div>
    <div class="hrl-field"><%= f.label :reason, "Note (optional)" %><%= f.text_area :reason %></div>
    <div class="hrl-form-actions">
      <%= f.submit "Record leave", class: "hrl-btn hrl-btn--primary" %>
      <a class="hrl-btn" href="<%= hr_lite.admin_leave_requests_path %>">Cancel</a>
    </div>
  <% end %>
</section>
