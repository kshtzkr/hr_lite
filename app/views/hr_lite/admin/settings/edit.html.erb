<% content_for(:page_title) { "HR settings" } %>
<div class="hrl-page__head">
  <h1 class="hrl-page__title">HR settings</h1>
</div>

<section class="hrl-card">
  <%= form_with model: @setting, url: hr_lite.admin_setting_path, method: :patch, local: true do |f| %>
    <%= render "hr_lite/shared/form_errors", record: @setting %>
    <h2 class="hrl-card__title">Working week</h2>
    <div class="hrl-field">
      <%= f.label :weekend_policy, "Weekly off policy" %>
      <%= f.select :weekend_policy, { "Sunday only" => "sun_only", "Saturday and Sunday" => "sat_sun", "Sunday, 2nd and 4th Saturday" => "second_fourth_sat_sun" }.select { |_, v| v.in?(HrLite::Setting::WEEKEND_POLICIES) } %>
      <p class="hrl-hint">Drives working-day math everywhere: leave counting, attendance, payroll.</p>
    </div>
    <h2 class="hrl-card__title hrl-mt">Breaks</h2>
    <div class="hrl-field">
      <%= f.label :lunch_break_minutes, "Lunch break limit (minutes)" %>
      <%= f.number_field :lunch_break_minutes, min: 5, max: 120 %>
      <p class="hrl-hint">One lunch a day; it ends by itself at this limit.</p>
    </div>
    <div class="hrl-field">
      <%= f.label :short_break_minutes, "Short break limit (minutes)" %>
      <%= f.number_field :short_break_minutes, min: 1, max: 60 %>
    </div>
    <h2 class="hrl-card__title hrl-mt">Working day</h2>
    <div class="hrl-field">
      <%= f.label :day_minutes, "Working day (minutes, break included)" %>
      <%= f.number_field :day_minutes, min: 240, max: 720, step: 15 %>
      <p class="hrl-hint">Check-in to check-out. 510 = 8h 30m (8h work + 30m break). Leaving earlier adds 30 min to the next working day.</p>
    </div>
    <div class="hrl-field">
      <%= f.label :half_day_below_minutes, "Half day below (minutes worked)" %>
      <%= f.number_field :half_day_below_minutes, min: 15, step: 15 %>
      <p class="hrl-hint">Working fewer minutes than this marks the day a half day and tells the person. 255 = 4h 15m.</p>
    </div>
    <div class="hrl-field">
      <%= f.label :recheck_in_from, "Check in again: from" %>
      <%= f.time_field :recheck_in_from %>
    </div>
    <div class="hrl-field">
      <%= f.label :recheck_in_until, "Check in again: until" %>
      <%= f.time_field :recheck_in_until %>
      <p class="hrl-hint">After checking out, a person can check in again once a day inside these hours.</p>
    </div>
    <h2 class="hrl-card__title hrl-mt">Penalties and codes</h2>
    <div class="hrl-field">
      <%= f.label :penalty_leave_type_id, "Penalties come off" %>
      <%= f.collection_select :penalty_leave_type_id, HrLite::LeaveType.active, :id, :name, { include_blank: "No leave (penalties stay as time)" }, data: { hrl_filter: "Type a leave type to filter" } %>
      <p class="hrl-hint">Every working day of penalty time this leave year holds one day of this leave, in half days, and leave past it is refused. Removing a penalty gives the day back.</p>
    </div>
    <div class="hrl-field">
      <%= f.label :employee_code_prefix, "Employee code prefix" %>
      <%= f.text_field :employee_code_prefix %>
      <p class="hrl-hint">Codes are assigned automatically as
        <%= @setting.employee_code_prefix %>001, <%= @setting.employee_code_prefix %>002, …
        — you only choose the prefix.</p>
    </div>
    <div class="hrl-form-actions">
      <%= f.submit "Save", class: "hrl-btn hrl-btn--primary" %>
    </div>
  <% end %>
</section>
