<section class="hrl-card">
  <%= form_with model: structure, url: url, method: method, scope: :salary_structure, local: true do |f| %>
    <%= render "hr_lite/shared/form_errors", record: structure %>
    <% breakup = structure.breakup(on: structure.effective_from || Date.current) if structure.basic %>
    <div class="hrl-field">
      <%= f.label :annual_ctc, "Annual CTC (₹ a year)" %>
      <%= f.number_field :annual_ctc, step: 1, min: 1, required: true, value: (structure.annual_ctc || breakup&.dig(:annual_ctc))&.round %>
      <p class="hrl-hint">The only amount you type. Saving splits it: Basic 50%, HRA 50% of Basic in a metro (40% elsewhere), employer PF, ESI and gratuity (4.81% of Basic) inside the CTC, the rest as special allowance.</p>
    </div>
    <div class="hrl-field">
      <%= f.label :effective_from, "Effective from (1st of month)" %>
      <%= f.date_field :effective_from %>
    </div>
    <div class="hrl-field hrl-field--check"><%= f.check_box :metro %><%= f.label :metro, "Works in a metro (Delhi, Mumbai, Kolkata, Chennai)" %></div>
    <div class="hrl-field hrl-field--check"><%= f.check_box :pf_applicable %><%= f.label :pf_applicable, "PF applicable" %></div>
    <div class="hrl-field hrl-field--check"><%= f.check_box :pf_on_full_basic %><%= f.label :pf_on_full_basic, "PF on full basic (no ₹15k ceiling)" %></div>
    <div class="hrl-field hrl-field--check"><%= f.check_box :esi_applicable %><%= f.label :esi_applicable, "ESI applicable (auto-exempt above gross ceiling)" %></div>
    <div class="hrl-field">
      <%= f.label :pt_state, "Professional tax state" %>
      <%# A stored rate card carries no PT (slabs live in their own table), so list those states too. %>
      <% pt_states = [ HrLite::ProfessionalTaxSlab::NO_LEVY, structure.pt_state ] |
                     HrLite::ProfessionalTaxSlab.distinct.order(:state).pluck(:state) |
                     HrLite::StatutoryRateCard.for(Date.current)[:pt].keys %>
      <%= f.select :pt_state, pt_states.map { |s| [ s.humanize, s ] } %>
    </div>
    <div class="hrl-field"><%= f.label :notes %><%= f.text_area :notes %></div>
    <% if breakup %>
      <h3 class="hrl-card__title">Monthly split</h3>
      <dl class="hrl-deflist">
        <% breakup[:earnings].each do |label, amount| %><dt><%= label %></dt><dd><%= hrl_money(amount) %></dd><% end %>
        <dt><strong>Gross</strong></dt><dd><strong><%= hrl_money(breakup[:monthly_gross]) %></strong></dd>
        <% breakup[:employer].each do |label, amount| %><dt>Employer <%= label %></dt><dd><%= hrl_money(amount) %></dd><% end %>
        <dt><strong>CTC</strong></dt><dd><strong><%= hrl_money(breakup[:monthly_ctc]) %></strong> a month</dd>
      </dl>
    <% end %>
    <div class="hrl-form-actions">
      <%= f.submit "Save structure", class: "hrl-btn hrl-btn--primary" %>
      <a class="hrl-btn" href="<%= hr_lite.admin_employee_path(@profile) %>">Cancel</a>
    </div>
  <% end %>
</section>
