<div class="hrl-page__head">
  <h1 class="hrl-page__title">Hello, <%= hr_display_name(hr_current_user) %></h1>
</div>

<% if @waiting.positive? %>
  <section class="hrl-card">
    <h2 class="hrl-card__title"><%= pluralize(@waiting, "request") %> waiting on you</h2>
    <a class="hrl-btn hrl-btn--primary hrl-mt" href="<%= hr_lite.approvals_path %>">Review requests</a>
  </section>
<% end %>

<div class="hrl-grid hrl-grid--2">
  <%= render "hr_lite/attendance/punch_card", attention: @attention %>
  <%= render "hr_lite/leave_requests/balance_chips" %>

  <% if @mine_pending.any? %>
    <section class="hrl-card">
      <h2 class="hrl-card__title">My requests</h2>
      <% @mine_pending.each do |req| %>
        <% title, detail, href = case req
             when HrLite::LeaveRequest then [ req.leave_type.name, "#{req.date_range_label} · #{pluralize(hrl_days(req.days_count), 'day')}", hr_lite.leave_request_path(req) ]
             when HrLite::RegularizationRequest then [ "Attendance fix", "#{req.date.strftime('%a %-d %b')} · #{req.times_label}", hr_lite.regularization_requests_path ]
             else [ "Comp-off", "Worked #{req.date_worked.strftime('%a %-d %b')}", hr_lite.comp_off_requests_path ]
             end %>
        <a class="hrl-listrow" href="<%= href %>">
          <span><%= title %></span>
          <%= hrl_request_status_badge(req.status) %>
          <span class="hrl-small hrl-muted"><%= detail %></span>
        </a>
      <% end %>
    </section>
  <% end %>
  <%= render "hr_lite/holidays/next_holiday" %>

  <section class="hrl-card">
    <h2 class="hrl-card__title">On leave this week</h2>
    <%= render "hr_lite/leave_requests/out_list", leaves: @out_week, empty: "Nobody is on leave this week." %>
    <a class="hrl-card__link" href="<%= hr_lite.team_path %>">Team board</a>
  </section>

  <section class="hrl-card">
    <h2 class="hrl-card__title">Latest kudos</h2>
    <% if @latest_kudos.any? %>
      <div class="hrl-feed">
        <%= render partial: "hr_lite/kudos/kudo", collection: @latest_kudos %>
      </div>
    <% else %>
      <p class="hrl-muted hrl-small">No kudos yet — be the first to appreciate a teammate.</p>
    <% end %>
    <a class="hrl-btn hrl-mt" href="<%= hr_lite.kudos_path %>">Give kudos</a>
  </section>
</div>

<% content_for :scripts do %>
  <%= javascript_include_tag "hr_lite/geo_punch", defer: true %>
<% end %>
