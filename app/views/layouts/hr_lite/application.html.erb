<!DOCTYPE html>
<html lang="en">
<head>
  <% company = HrLite.config.company.call %>
  <title><%= [ content_for(:page_title), "#{company[:name].presence || 'HR'} — HR" ].compact.join(" · ") %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= yield :head %>
  <%= stylesheet_link_tag "hr_lite/hr_lite", media: "all" %>
  <% HrLite.config.extra_stylesheets.each do |sheet| %>
    <%= stylesheet_link_tag sheet, media: "all" %>
  <% end %>
</head>
<body class="hrl-body">
  <a class="hrl-skip" href="#hrl-main">Skip to content</a>
  <div class="hrl-shell">
    <%# Keka-style left rail on desktop; slides away on phones (tabbar takes over). %>
    <aside class="hrl-side" aria-label="HR navigation">
      <a class="hrl-side__brand" href="<%= hr_lite.root_path %>">
        <% if company[:logo_url].present? %>
          <img class="hrl-side__logo" src="<%= company[:logo_url] %>" alt="<%= company[:name] %>">
        <% else %>
          <span class="hrl-side__brandname"><%= company[:name].presence || "HR" %></span>
        <% end %>
      </a>

      <nav class="hrl-side__nav">
        <a class="hrl-nav__link" href="<%= hr_lite.search_path %>" data-hrl-search-open><%= hrl_icon("Search") %>Search<span class="hrl-sr-only"> (Ctrl K)</span></a>
        <% hrl_sections.each do |section| %>
          <% if section[:divider] %><span class="hrl-side__divider" aria-hidden="true"></span><% end %>
          <%= hrl_nav_link(section) %>
        <% end %>
      </nav>

      <div class="hrl-side__foot">
        <span class="hrl-side__user" title="<%= hr_current_user&.email %>"><%= hr_display_name(hr_current_user) %></span>
        <%= render "hr_lite/shared/bell" %>
        <% if HrLite.config.back_link %>
          <a class="hrl-side__back" href="<%= HrLite.config.back_link[:url] %>"><%= HrLite.config.back_link[:label] %></a>
        <% end %>
      </div>
    </aside>

    <div class="hrl-content">
      <header class="hrl-appbar hrl-appbar--mobile">
        <a class="hrl-appbar__brand" href="<%= hr_lite.root_path %>">
          <% if company[:logo_url].present? %>
            <img class="hrl-appbar__logo" src="<%= company[:logo_url] %>" alt="<%= company[:name] %>">
          <% else %>
            <%= company[:name].presence || "HR" %>
          <% end %>
        </a>
        <%= render "hr_lite/shared/bell" %>
        <% profile = hr_lite.employee_profile_path if hr_lite_route?(:employee_profile_path) %>
        <%= tag.a hr_display_name(hr_current_user), href: profile, class: "hrl-appbar__user" %>
      </header>

      <main class="hrl-main" id="hrl-main" tabindex="-1">
        <%# A page about one person puts that person's tabs here instead (shared/_person_tabs). %>
        <% if content_for?(:tabrow) %>
          <%= yield :tabrow %>
        <% elsif (section = hrl_current_section) && section[:tabs].many? %>
          <nav class="hrl-tabrow" aria-label="<%= section[:label] %> sections">
            <% section[:tabs].each do |tab| %><%= hrl_nav_link(tab) %><% end %>
          </nav>
        <% end %>
        <%# A sub-screen names its parent place or tab: content_for(:back, "Leave"). %>
        <% if (tab = (hrl_sections + hrl_sections.flat_map { |s| s[:tabs] }).find { |i| i[:label] == content_for(:back) }) %>
          <a class="hrl-backlink" href="<%= hr_lite.public_send(tab[:path]) %>"><span aria-hidden="true">‹</span> <%= tab[:label] %></a>
        <% end %>
        <% if flash[:notice].present? %><div class="hrl-flash hrl-flash--ok" role="status"><%= flash[:notice] %></div><% end %>
        <% if flash[:alert].present? %><div class="hrl-flash hrl-flash--warn" role="alert"><%= flash[:alert] %>
          <% if flash[:alert] == HrLite::AttendancePuncher::OFF_SITE_MESSAGE %><div class="hrl-mt"><a class="hrl-btn" href="<%= hr_lite.wfh_requests_path %>">Request WFH</a></div><% end %>
        </div><% end %>
        <%= yield %>
      </main>
    </div>
  </div>

  <%# The left rail is display:none below 768px, so before the More sheet
      existed the phone — the surface this is installed on — could reach only
      the first five items. Org, Kudos, Slips, Career and every admin,
      leadership and payroll screen were unreachable. <details> keeps it
      dependency-free; the engine ships no Turbo or Stimulus. %>
  <nav class="hrl-tabbar" aria-label="HR sections">
    <% primary, rest = hrl_sections.partition.with_index { |_, i| i < 4 } %>
    <% primary.each do |section| %>
      <%= hrl_nav_link(section) %>
    <% end %>
    <details class="hrl-tabbar__more">
      <% lit = rest.any? { |s| hrl_nav_active?(s) } %>
      <%= tag.summary safe_join([ hrl_icon("More"), "More" ]), class: [ "hrl-nav__link", ("hrl-nav__link--active" if lit) ], aria: { current: ("true" if lit) } %>
      <div class="hrl-sheet">
        <% if HrLite.config.back_link %>
          <a class="hrl-nav__link hrl-side__back" href="<%= HrLite.config.back_link[:url] %>"><%= HrLite.config.back_link[:label] %></a>
        <% end %>
        <a class="hrl-nav__link" href="<%= hr_lite.search_path %>" data-hrl-search-open><%= hrl_icon("Search") %>Search<span class="hrl-sr-only"> (Ctrl K)</span></a>
        <%# The second line names the place's tabs, so a phone user knows what is inside before opening it. %>
        <% rest.each do |section| %>
          <%= hrl_nav_link(section, hint: section[:tabs].map { |t| t[:label] }.join(", ")) %>
        <% end %>
      </div>
    </details>
  </nav>

  <%= javascript_include_tag "hr_lite/confirm", defer: true %>
  <%= javascript_include_tag "hr_lite/mention", defer: true %>
  <%= javascript_include_tag "hr_lite/nav", defer: true %>
<%= javascript_include_tag "hr_lite/select_filter", defer: true %>
<%= javascript_include_tag "hr_lite/search", defer: true %>
<dialog class="hrl-search" data-hrl-search aria-label="Search">
  <form action="<%= hr_lite.search_path %>" method="get" role="search">
    <label class="hrl-sr-only" for="hrl-search-q">Search screens and people</label>
    <input id="hrl-search-q" class="hrl-input" type="search" name="q" placeholder="Search screens and people" autocomplete="off">
  </form>
  <div data-hrl-search-results aria-live="polite"></div>
</dialog>
  <%= yield :scripts %>
</body>
</html>
